<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center_vertical">

    <ImageView
        android:id="@+id/icon_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentLeft="true"
        android:layout_alignParentStart="true"
        android:src="@android:drawable/ic_delete" />

    <TextView
        android:id="@+id/text_c_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toRightOf="@+id/icon_action"
        android:paddingLeft="5dp"
        android:text="123"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/text_prefix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toRightOf="@+id/text_c_code"
        android:paddingLeft="5dp"
        android:text="1234567890"
        android:textSize="20sp" />

    <ImageButton
        android:id="@+id/icon_edit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toLeftOf="@+id/icon_delete"
        android:padding="10dp"
        android:src="@android:drawable/ic_menu_edit"
        android:onClick="editPrefix" />

    <ImageButton
        android:id="@+id/icon_delete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentRight="true"
        android:padding="10dp"
        android:src="@android:drawable/ic_menu_delete"
        android:onClick="deletePrefix" />

</RelativeLayout>
